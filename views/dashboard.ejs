<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Botola Fantasy - <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .formation-container { background: #0b5ed7; border-radius: 8px; min-height: 220px; padding: 12px; }
    .formation-row { display: flex; justify-content: center; gap: 6px; margin: 6px 0; flex-wrap: wrap; }
    .formation-player { background: rgba(255,255,255,0.15); color: #fff; border-radius: 6px; padding: 6px 8px; text-align: center; min-width: 90px; position: relative; cursor: pointer; }
    .formation-player.captain { outline: 2px solid #ffc107; }
    .formation-player.mark-out { outline: 2px dashed #ff4d4f; }
    .captain-badge, .vice-badge { position: absolute; top: -8px; right: -8px; background: #ffc107; color: #000; font-weight: 700; border-radius: 50%; padding: 2px 6px; font-size: 10px; }
    .vice-badge { background: #6c757d; color: #fff; right: -8px; top: 18px; }
    .player-card.selected { outline: 2px solid #198754; }
    .small-muted { font-size: 12px; color: #6c757d; }
    .badge-locked { background: #dc3545; }
    .badge-open { background: #198754; }
    .bench-select { min-width: 70px; }
    .lock-overlay { pointer-events: none; opacity: 0.6; }
    .sticky-mobile-bar { position: sticky; bottom: 0; background: #fff; z-index: 20; border-top: 1px solid #eee; padding: 8px 12px; }
    .player-card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px; margin-bottom: 8px; }
    .player-card .btn { padding: 2px 8px; }
    @media (max-width: 576px) {
      .formation-player { min-width: 72px; font-size: 12px; padding: 6px; }
      .formation-container { min-height: 180px; }
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="bi bi-trophy-fill me-2"></i> Botola Fantasy</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% if (user) { %>
            <li class="nav-item"><a class="nav-link active" href="/dashboard">My Team</a></li>
            <li class="nav-item"><a class="nav-link" href="/leaderboard">Leaderboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/friends">Friends</a></li>
            <li class="nav-item"><a class="nav-link" href="/leagues">Leagues</a></li>
            <% if (user.isAdmin) { %><li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li><% } %>
            <li class="nav-item"><span class="navbar-text text-white me-3">Welcome, <%= user.username %>!</span></li>
            <li class="nav-item"><button class="btn btn-outline-light" onclick="logout()">Logout</button></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/leaderboard">Leaderboard</a></li>
            <li class="nav-item"><a class="nav-link btn btn-outline-light ms-2" href="/login">Login</a></li>
            <li class="nav-item"><a class="nav-link btn btn-success ms-2" href="/signup">Sign Up</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

<div class="container-fluid py-3">
  <div class="row g-3">
    <div class="col-12">
      <h2 class="mb-2">My Team</h2>
      <div id="alertContainer"></div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
        <span class="badge bg-primary">Active GW: <span id="activeGWLabel">—</span></span>
        <span class="badge bg-dark">Deadline: <span id="deadlineLabel">—</span></span>
        <span id="lockStatus" class="badge">Status: <span id="lockStatusLabel">—</span></span>
        <span class="badge bg-info text-dark">Free Transfers: <span id="freeTransfersLabel">—</span></span>
        <span class="badge bg-secondary">Transfers This GW: <span id="transfersGWLabel">—</span></span>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-1">
    <div class="col-sm-6 col-lg-4">
      <div class="card"><div class="card-body">
        <h6 class="card-title">Budget</h6>
        <div class="budget-bar mb-2"><div class="budget-fill"></div></div>
        <div class="d-flex justify-content-between small">
          <span>Spent: <strong id="budget-spent">0</strong>M</span>
          <span>Remaining: <strong id="budget-remaining">100</strong>M</span>
        </div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-4">
      <div class="card"><div class="card-body">
        <h6 class="card-title">Total Points</h6>
        <h3 class="text-center mb-0" id="totalPoints">0</h3>
      </div></div>
    </div>
    <div class="col-sm-12 col-lg-4">
      <div class="card"><div class="card-body">
        <h6 class="card-title">Squad Status</h6>
        <div class="d-flex flex-wrap gap-3 small">
          <span>GK: <strong id="gk-count">0</strong>/2</span>
          <span>DEF: <strong id="def-count">0</strong>/5</span>
          <span>MID: <strong id="mid-count">0</strong>/5</span>
          <span>FWD: <strong id="fwd-count">0</strong>/3</span>
        </div>
      </div></div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0">Your Squad</h6>
          <div class="d-flex align-items-center gap-2">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="transferModeSwitch" onchange="toggleTransferMode(this.checked)">
              <label class="form-check-label small" for="transferModeSwitch">Transfer Mode</label>
            </div>
          </div>
        </div>
        <div class="card-body" id="squadCardBody">
          <div class="formation-container" id="formation-display">
            <div class="text-center text-white py-5"><p>Select players to build your squad</p></div>
          </div>

          <div class="row mt-3 g-2">
            <div class="col-md-6">
              <label class="form-label small">Captain</label>
              <select id="captainSelect" class="form-select form-select-sm"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Vice-Captain</label>
              <select id="viceCaptainSelect" class="form-select form-select-sm"></select>
            </div>
          </div>

          <div class="mt-3">
            <h6 class="small">Lineup Builder</h6>
            <div id="lineup-builder" class="small text-muted">Add players to your squad first.</div>
          </div>

          <div class="sticky-mobile-bar mt-3 d-flex flex-wrap gap-2 justify-content-between">
            <div class="small">Selected: <strong id="selectedCountLabel">0</strong>/15</div>
            <div class="d-flex flex-wrap gap-2">
              <button id="saveTeamBtn" class="btn btn-primary btn-sm" onclick="saveTeam()"><i class="bi bi-save"></i> Save Team</button>
              <button id="clearTeamBtn" class="btn btn-outline-danger btn-sm" onclick="clearTeam()"><i class="bi bi-trash"></i> Clear</button>
              <button id="saveLineupBtn" class="btn btn-outline-secondary btn-sm" onclick="saveLineup()"><i class="bi bi-people"></i> Save Lineup</button>
              <button id="saveCaptainsBtn" class="btn btn-outline-primary btn-sm" onclick="saveCaptains()"><i class="bi bi-person-badge"></i> Save Captains</button>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0">Available Players</h6>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#filtersCanvas"><i class="bi bi-sliders"></i> Filters</button>
            <div class="d-none d-lg-flex align-items-center gap-2">
              <input class="form-control form-control-sm" id="searchInput" placeholder="Search name..." oninput="filterPlayers()" style="max-width: 180px;">
              <select class="form-select form-select-sm" id="clubFilter" onchange="filterPlayers()" style="max-width: 180px;"><option value="">All Clubs</option></select>
              <select class="form-select form-select-sm" id="sortFilter" onchange="filterPlayers()" style="max-width: 160px;"><option value="price">Sort by Price</option><option value="points">Sort by Points</option><option value="name">Sort by Name</option></select>
            </div>
          </div>
        </div>
        <div class="card-body" id="availablePlayersCardBody">
          <div class="d-lg-none mb-2">
            <input class="form-control form-control-sm" id="searchInputMobile" placeholder="Search name..." oninput="filterPlayers()">
          </div>
          <ul class="nav nav-tabs small" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#gk-players">GK</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#def-players">DEF</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#mid-players">MID</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#fwd-players">FWD</a></li>
          </ul>
          <div class="tab-content" style="max-height: 520px; overflow-y: auto;">
            <div class="tab-pane fade show active" id="gk-players"><div class="py-3 text-muted">Loading goalkeepers...</div></div>
            <div class="tab-pane fade" id="def-players"><div class="py-3 text-muted">Loading defenders...</div></div>
            <div class="tab-pane fade" id="mid-players"><div class="py-3 text-muted">Loading midfielders...</div></div>
            <div class="tab-pane fade" id="fwd-players"><div class="py-3 text-muted">Loading forwards...</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Offcanvas filters for mobile -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="filtersCanvas">
  <div class="offcanvas-header">
    <h6 class="offcanvas-title">Filters</h6>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <div class="mb-2">
      <label class="form-label small">Search</label>
      <input class="form-control form-control-sm" id="searchInputOC" placeholder="Name..." oninput="filterPlayers()">
    </div>
    <div class="mb-2">
      <label class="form-label small">Club</label>
      <select class="form-select form-select-sm" id="clubFilterOC" onchange="filterPlayers()"><option value="">All Clubs</option></select>
    </div>
    <div class="mb-2">
      <label class="form-label small">Sort</label>
      <select class="form-select form-select-sm" id="sortFilterOC" onchange="filterPlayers()"><option value="price">Sort by Price</option><option value="points">Sort by Points</option><option value="name">Sort by Name</option></select>
    </div>
    <button class="btn btn-primary w-100 mt-2" data-bs-dismiss="offcanvas">Apply</button>
  </div>
</div>

<footer class="bg-dark text-white py-4 mt-4">
  <div class="container text-center">
    <p>&copy; 2025 Botola Fantasy. All rights reserved.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>
