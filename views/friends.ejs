<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Botola Fantasy - <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="bi bi-trophy-fill me-2"></i> Botola Fantasy</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link" href="/dashboard">My Team</a></li>
          <li class="nav-item"><a class="nav-link" href="/leaderboard">Leaderboard</a></li>
          <li class="nav-item"><a class="nav-link active" href="/friends">Friends</a></li>
          <li class="nav-item"><a class="nav-link" href="/leagues">Leagues</a></li>
          <% if (user.isAdmin) { %><li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li><% } %>
          <li class="nav-item"><span class="navbar-text text-white me-3">Welcome, <%= user.username %>!</span></li>
          <li class="nav-item"><button class="btn btn-outline-light" onclick="logout()">Logout</button></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/leaderboard">Leaderboard</a></li>
          <li class="nav-item"><a class="nav-link btn btn-outline-light ms-2" href="/login">Login</a></li>
          <li class="nav-item"><a class="nav-link btn btn-success ms-2" href="/signup">Sign Up</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<div class="container py-4">
  <h2 class="mb-4">Friends</h2>
  <div id="friendsAlert"></div>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header"><strong>Find Users</strong></div>
        <div class="card-body">
          <div class="input-group mb-3">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Search by username or email">
            <button class="btn btn-primary" onclick="searchUsers()">Search</button>
          </div>
          <div id="searchResults"><div class="text-muted">Type to find users...</div></div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong>Incoming Requests</strong>
          <span class="badge bg-secondary" id="incomingCount">0</span>
        </div>
        <div class="card-body" id="incomingList"><div class="text-muted">No incoming requests</div></div>
      </div>

      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong>Outgoing Requests</strong>
          <span class="badge bg-secondary" id="outgoingCount">0</span>
        </div>
        <div class="card-body" id="outgoingList"><div class="text-muted">No outgoing requests</div></div>
      </div>

      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong>My Friends</strong>
          <span class="badge bg-secondary" id="friendsCount">0</span>
        </div>
        <div class="card-body" id="friendsList"><div class="text-muted">No friends yet</div></div>
      </div>
    </div>
  </div>
</div>

<script src="/js/friends.js"></script>
<footer class="bg-dark text-white py-4 mt-5">
  <div class="container text-center">
    <p>&copy; 2025 Botola Fantasy. All rights reserved.</p>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
