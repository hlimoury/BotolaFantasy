<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Botola Fantasy - <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="bi bi-trophy-fill me-2"></i> Botola Fantasy</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link" href="/dashboard">My Team</a></li>
          <li class="nav-item"><a class="nav-link" href="/leaderboard">Leaderboard</a></li>
          <% if (user.isAdmin) { %><li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li><% } %>
          <li class="nav-item"><span class="navbar-text text-white me-3">Welcome, <%= user.username %>!</span></li>
          <li class="nav-item"><button class="btn btn-outline-light" onclick="logout()">Logout</button></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/leaderboard">Leaderboard</a></li>
          <li class="nav-item"><a class="nav-link btn btn-outline-light ms-2" href="/login">Login</a></li>
          <li class="nav-item"><a class="nav-link btn btn-success ms-2" href="/signup">Sign Up</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<section class="hero-section text-white text-center py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-4 fw-bold mb-4">Welcome to Botola Fantasy</h1>
        <p class="lead mb-4">Create your dream team from the Moroccan Botola Pro League. Compete with friends and fans!</p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/signup" class="btn btn-success btn-lg">Start Playing</a>
          <a href="#how-to-play" class="btn btn-outline-light btn-lg">How to Play</a>
        </div>
      </div>
      <div class="col-lg-6">
        <i class="bi bi-trophy-fill" style="font-size: 200px;"></i>
      </div>
    </div>
  </div>
</section>

<section class="py-5 bg-light">
  <div class="container">
    <h2 class="text-center mb-4">Current Gameweek</h2>
    <div id="currentGameweek" class="card">
      <div class="card-body text-center">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
      </div>
    </div>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <h2 class="text-center mb-4">Top Managers</h2>
    <div class="card shadow">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead><tr><th>Rank</th><th>Manager</th><th>Points</th></tr></thead>
            <tbody id="topManagersTable">
              <tr><td colspan="3" class="text-center">Loading...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="text-center mt-3">
          <a href="/leaderboard" class="btn btn-primary">View Full Leaderboard</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="how-to-play" class="py-5 bg-light">
  <div class="container">
    <h2 class="text-center mb-5">How to Play</h2>
    <div class="row g-4">
      <div class="col-md-4 text-center">
        <i class="bi bi-person-plus-fill" style="font-size:3rem;color:var(--morocco-green)"></i>
        <h4 class="mt-3">1. Create Your Account</h4>
        <p>Sign up for free and choose your favorite Botola Pro club</p>
      </div>
      <div class="col-md-4 text-center">
        <i class="bi bi-people-fill" style="font-size:3rem;color:var(--morocco-red)"></i>
        <h4 class="mt-3">2. Build Your Squad</h4>
        <p>Select 15 players within a 100M budget: 2 GK, 5 DEF, 5 MID, 3 FWD</p>
      </div>
      <div class="col-md-4 text-center">
        <i class="bi bi-trophy-fill" style="font-size:3rem;color:var(--morocco-gold)"></i>
        <h4 class="mt-3">3. Earn Points & Win</h4>
        <p>Your players earn points based on real match performances</p>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  // Load active gameweek + fixtures
  try {
    const res = await fetch('/api/gameweeks/active');
    const gw = await res.json();
    const container = document.getElementById('currentGameweek');
    if (!gw || !gw.matches || gw.matches.length === 0) {
      container.innerHTML = '<div class="card-body text-center">No gameweek data</div>';
      return;
    }
    const list = gw.matches.map(m => `
      <div class="row align-items-center py-2">
        <div class="col-md-4 text-end"><img src="${m.homeClub.logo || ''}" height="24" class="me-2"/> ${m.homeClub.name}</div>
        <div class="col-md-4 text-center"><strong>${m.homeScore ?? '-'} : ${m.awayScore ?? '-'}</strong><br><small>${new Date(m.date).toLocaleString()}</small></div>
        <div class="col-md-4 text-start"><img src="${m.awayClub.logo || ''}" height="24" class="me-2"/> ${m.awayClub.name}</div>
      </div>
      <hr class="my-1"/>
    `).join('');
    container.innerHTML = `<div class="card-body">${list}</div>`;
  } catch (e) {
    console.error(e);
  }
  // Top managers
  loadTopManagers();
});
</script>
<footer class="bg-dark text-white py-4 mt-5">
  <div class="container text-center">
    <p>&copy; 2025 Botola Fantasy. All rights reserved.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
