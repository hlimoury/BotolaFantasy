<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Botola Fantasy - <%= title || 'Play Test Notice' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #9b0000 0%, #007d02 100%);
      display: flex; align-items: center; justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
    }
    .notice-card {
      max-width: 680px; width: 92%;
      background: rgba(255,255,255,0.95);
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25);
      overflow: hidden;
      animation: floatIn .35s ease-out;
    }
    .notice-header {
      background: linear-gradient(135deg, #ff4d4f, #bf3032);
      color: #fff;
      padding: 22px 24px;
    }
    .notice-body { padding: 22px 24px; color: #333; }
    .badge-team { font-weight: 600; }
    .actions {
      display: flex; gap: 12px; padding: 16px 24px; background: #f8f9fa; justify-content: flex-end;
      border-top: 1px solid #eee;
    }
    @keyframes floatIn { from { transform: translateY(16px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
  </style>
</head>
<body>

  <div class="notice-card">
    <div class="notice-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <h5 class="m-0">Play Test Notice</h5>
      </div>
      <span class="badge bg-dark">v1</span>
    </div>

    <div class="notice-body">
      <p class="mb-3">
        Welcome! This is a play test environment for Botola Fantasy. During this test, the game is
        limited to the following 4 clubs:
      </p>

      <div class="mb-3">
        <span class="badge text-bg-success badge-team me-1">Raja</span>
        <span class="badge text-bg-danger badge-team me-1">Wydad</span>
        <span class="badge text-bg-dark badge-team me-1">AS FAR</span>
        <span class="badge text-bg-warning text-dark badge-team">RS Berkane</span>
      </div>

      <p class="mb-3">
        Things may change or break while we test. If you run into any issue or have feedback, please contact the developer:
      </p>

      <p class="mb-0">
        <a href="https://www.instagram.com/mozart1st/" target="_blank" rel="noopener" class="btn btn-outline-primary">
          <i class="bi bi-instagram me-1"></i> @mozart1st
        </a>
      </p>
    </div>

    <div class="actions">
      <button class="btn btn-outline-secondary" id="btnLater">
        <i class="bi bi-clock-history me-1"></i> Remind Me Later
      </button>
      <button class="btn btn-success" id="btnAcknowledge">
        <i class="bi bi-check2-circle me-1"></i> I Understand, Continue
      </button>
    </div>
  </div>

  <script>
    // One-time acknowledge using localStorage
    const KEY = 'playtest_ack_v1';
    const next = new URLSearchParams(location.search).get('next') || '/dashboard';

    document.getElementById('btnAcknowledge').addEventListener('click', () => {
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      location.href = next;
    });

    document.getElementById('btnLater').addEventListener('click', () => {
      // Don't persist; just continue without setting the key
      location.href = next;
    });
  </script>
</body>
</html>